# NPM Configuration for Production Builds
# Strict security settings for Hostinger deployment

# Require strict versions in lock file
strict-ssl=true

# Use package locks
package-lock=true

# Fail on audit issues in CI/production
audit-level=moderate

# Reduce log verbosity in production
production=true

# Prefer offline modules
prefer-offline=false

# Optimize for production builds
ignore-scripts=false
