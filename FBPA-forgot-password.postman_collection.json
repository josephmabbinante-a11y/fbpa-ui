          "raw": "{\n  \"email\": \"your-email@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/forgot-password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "forgot-password"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
