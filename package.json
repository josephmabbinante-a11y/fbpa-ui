{
  "name": "fbpa",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "api"
  ],
  "scripts": {
    "start": "npm --workspace=backend run start",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:api": "npm --workspace=api run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\" \"npm run dev:backend\"",
    "build:frontend": "npm --workspace=frontend run build",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
