# ============================================================================
# FBPA - Hostinger Node.js Deployment Environment Variables
# ============================================================================
# Copy this file to .env in your Hostinger deployment
# Replace all <placeholder> values with your actual configuration
# DO NOT commit .env to git - use Hostinger dashboard to set these
# ============================================================================

# ============================================================================
# NODE.JS & ENVIRONMENT
# ============================================================================
NODE_ENV=production
PORT=3000
# Note: Hostinger auto-assigns port, this is for local reference only

# ============================================================================
# DATABASE - MongoDB Atlas (Recommended for Hostinger)
# ============================================================================
# Get this from MongoDB Atlas:
# 1. Go to https://cloud.mongodb.com
# 2. Create cluster or use existing
# 3. Click "Connect" -> "Drivers" -> Copy connection string
# 4. Replace <username>, <password>, and <database-name>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority

# Alternative: MongoDB Connection Components
# (Use MONGODB_URI above instead - this is only if you need individual parts)
# MONGODB_USER=<your-mongo-user>
# MONGODB_PASSWORD=<your-mongo-password>
# MONGODB_HOST=<cluster-name>.mongodb.net
# MONGODB_DB=fbpa-db

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Generate a strong JWT secret with: openssl rand -base64 32
# Store this securely - never share or commit
JWT_SECRET=<generate-with-openssl-rand-base64-32>

# Password hash salt (optional, for backward compatibility)
PASSWORD_HASH_SALT=fbpa-hostinger-salt-<random-string>

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Your Hostinger domain (where frontend is deployed)
# Example: https://myfrightbilling.com
VITE_API_URL=https://<your-hostinger-domain>

# Frontend URL (same as above, used for email links)
FRONTEND_URL=https://<your-hostinger-domain>

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
# For Hostinger, this should be your domain(s)
CORS_ORIGIN=https://<your-hostinger-domain>,https://www.<your-hostinger-domain>

# Allow any Vercel preview deployment (if needed)
# Leave as true for development, set to false for production
ALLOW_VERCEL_ORIGINS=false

# ============================================================================
# STATIC FILE SERVING
# ============================================================================
# Set to true to serve frontend static files from backend
# REQUIRED for single-process Hostinger deployment
SERVE_STATIC=true

# ============================================================================
# EMAIL / SMTP CONFIGURATION
# ============================================================================
# Required for: password reset, email verification, notifications

# For Hostinger Email:
# Get SMTP details from: hPanel -> Email -> Email Accounts -> More -> SMTP Settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=<your-hostinger-email@yourdomain.com>
SMTP_PASS=<your-hostinger-email-password>
SMTP_FROM=noreply@<yourdomain.com>

# Alternative: Use third-party email service (Mailgun, SendGrid, etc.)
# SMTP_HOST=smtp.mailgun.org
# SMTP_USER=<mailgun-smtp-user>
# SMTP_PASS=<mailgun-smtp-password>

# ============================================================================
# REGISTRATION CONFIGURATION
# ============================================================================
# Email domain for auto-generated user emails (if user doesn't provide full email)
REGISTER_EMAIL_DOMAIN=users.<yourdomain.com>

# ============================================================================
# DATABASE CONNECTION POOLING (Hostinger Optimization)
# ============================================================================
# Keep these LOW for Hostinger shared/cloud hosting
# Adjust if you upgrade to VPS
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=5
MAX_CONNECTIONS=50

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================
# Add these if you have integrations with third-party services

# HERE Maps API (for route intelligence - optional)
# Sign up at: https://developer.here.com
HERE_API_KEY=<optional-here-maps-api-key>

# Rate Limiting (optional, for API protection)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# OPTIONAL: DEVELOPMENT/DEBUGGING (Remove for Production)
# ============================================================================
# Allow any user to login without verification (DEV ONLY)
DEV_AUTH_ALLOW_ANY=false

# Enable debug logging
DEBUG=false

# ============================================================================
# HOSTINGER DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to Hostinger:
#
# [ ] Set MONGODB_URI with valid MongoDB Atlas connection string
# [ ] Generate and set JWT_SECRET using: openssl rand -base64 32
# [ ] Set VITE_API_URL to your Hostinger domain (with https://)
# [ ] Set CORS_ORIGIN to your Hostinger domain(s)
# [ ] Configure SMTP_* for email functionality
# [ ] Update REGISTER_EMAIL_DOMAIN if using custom domain
# [ ] Set NODE_ENV=production
# [ ] Set SERVE_STATIC=true (required for single-process deployment)
# [ ] Test locally: npm install && npm run build:frontend && npm start
# [ ] Verify all connections work before Hostinger deployment
#
# ============================================================================
# HOSTINGER DASHBOARD SETUP
# ============================================================================
# 1. Go to Hostinger hPanel
# 2. Navigate to: Applications → Node.js Apps → Add Application
# 3. Connect your GitHub repository: josephmabbinante-a11y/fbpa-ui
# 4. Set:
#    - Branch: FBPA
#    - Application root: /
#    - Node version: 20.x
#    - Package manager: npm
#    - Build command: npm install && npm run build:frontend
#    - Start command: node backend/server/index.js
# 5. Under "Environment variables" section, add ALL variables from this file
# 6. Click "Deploy"
#
# ============================================================================
# TROUBLESHOOTING
# ============================================================================
# Error: "Cannot find module"
#   → Run: npm install --production
#
# Error: "MONGODB_URI contains placeholder brackets"
#   → Update MONGODB_URI with real MongoDB Atlas credentials
#
# Error: "CORS policy: No 'Access-Control-Allow-Origin' header"
#   → Check CORS_ORIGIN matches your Hostinger domain exactly
#
# Error: "Email verification failed"
#   → Verify SMTP_HOST, SMTP_USER, SMTP_PASS are correct
#
# Error: "Database unavailable"
#   → Check MongoDB Atlas IP whitelist includes Hostinger IPs
#   → Verify MONGODB_URI connection string
#
# ============================================================================
