                                {"key": "Content-Type", "value": "application/json"}
                            ],
                            "body": {
                                "mode": "raw",
                                "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"name\": \"Test User\",\n  \"role\": \"user\"\n}"
                            },
                            "url": {
                                "raw": "{{base_url}}/auth/signup",
                                "host": ["{{base_url}}"],
