{
{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://mongodb-production-744f.up.railway.app/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "https://mongodb-production-744f.up.railway.app"
  },
  "engines": {
    "node": "18"
  }
}
