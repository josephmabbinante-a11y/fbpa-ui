# ⚠️ SECURITY WARNING:
# This is an example file. Copy this to .env.local and fill in your actual values.
# (.env.local is gitignored and takes precedence over .env in Vite.)
# NEVER commit .env files with real credentials to git.

# -------------------------------------------------------------------
# Frontend-only environment variables (all must be prefixed VITE_).
# Backend secrets (MONGODB_URI, JWT_SECRET, etc.) belong in the
# backend/.env or in the backend platform's dashboard — NOT here.
# -------------------------------------------------------------------

# Backend API base URL (no trailing slash).
# Local development: point at your local Express server.
# Production (Vercel): set this in the Vercel dashboard under
#   Project → Settings → Environment Variables → VITE_API_URL
VITE_API_URL=http://localhost:4000

# Multitenant API base URL (local development only)
VITE_MT_API_URL=http://localhost:4001

# Google Maps API key (optional — for map embeds)
VITE_GOOGLE_MAPS_KEY=YOUR_KEY_HERE

# Mock/Demo Mode — set to true to use simulated data instead of real API
VITE_USE_MOCK_API=false
VITE_MOCK_MODE=false

# Set to true to skip login in development/testing (never set in production).
# VITE_DEV_BYPASS_LOGIN=true
