# ⚠️ SECURITY WARNING:
# This is an example file. Copy this to .env and fill in your actual values.
# NEVER commit .env files with real credentials to git.
# The credentials previously in this repository have been exposed and MUST be rotated.

# MongoDB Connection String
# Get this from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Secret for authentication
# Generate a strong random secret (e.g., using: openssl rand -base64 32)
JWT_SECRET=your_secret_key_here

# Server Port
PORT=4000

# CORS Origin (frontend URL, comma-separated for multiple)
# Example: http://localhost:5173,https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5173

# Serve static files (set to "true" in production)
SERVE_STATIC=false

# Development auth (only for local development)
DEV_AUTH_ALLOW_ANY=false

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.ethereal.email
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@audit-iq.com
# Backend API URL
VITE_API_URL=http://localhost:4000

# For production, set this to your Render backend URL:
# VITE_API_URL=https://your-backend-url.onrender.com

# Set to true to skip login in development/testing (never set in production)
# VITE_DEV_BYPASS_LOGIN=true

# Backend Environment Variables (set in Render dashboard):
# MONGODB_URI=mongodb+srv://...
# JWT_SECRET=(generate with: openssl rand -base64 32)
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend-url.onrender.com
# SERVE_STATIC=false
# Frontend
VITE_GOOGLE_MAPS_KEY=YOUR_KEY_HERE

# Backend MongoDB (choose one approach)
# 1) Full URI
MONGODB_URI=

# 2) Or component values (used when MONGODB_URI is empty)
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DB=fbpa-db
