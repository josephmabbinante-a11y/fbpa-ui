{
  "info": {
    "name": "FBPA Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text",
            "description": "Indicates the expected response format"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text",
            "description": "Specifies the request body format"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"yourSecurePassword123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/auth/signup",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["auth", "signup"]
        },
        "description": "Create a new user account. Password must be at least 8 characters."
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text",
            "description": "Indicates the expected response format"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text",
            "description": "Specifies the request body format"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"yourSecurePassword123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:4000/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["auth", "login"]
        },
        "description": "Authenticate an existing user and receive a JWT access token."
      }
    }
  ]
